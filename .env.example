# 复制为项目根目录的 .env；后端启动时会自动加载
# DeepSeek API Key（必填，供 deepseek-chat 使用）
DEEPSEEK_API_KEY=sk-your_api_key_here

# LLM 可靠性策略：单次超时、额外重试次数、指数退避
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=1
# 每分钟最大调用数；0 表示不启用窗口限流，最小调用间隔仍生效
LLM_RATE_LIMIT_PER_MINUTE=30
LLM_MIN_INTERVAL_SECONDS=0.2
# 等待限流令牌的最长时间，超时后返回 rate_limited 降级状态
LLM_RATE_LIMIT_WAIT_SECONDS=10

# 数据库连接（可选；不设置时使用项目根目录的 SQLite screener.db）
# 使用 MySQL 时取消注释并填写真实连接信息
# MYSQL_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/screener

# GitHub API Token（可选；仅启用 GitHub Enrich 时使用）
GITHUB_TOKEN=ghp_your_github_token_here

# MinerU 精准解析 API（本地 PDF 先申请上传 URL，再上传、轮询并下载 full.md）
# 不要把真实 Token 提交到 Git；请写入项目根目录 .env
MINERU_API_ENABLED=true
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_IS_OCR=false
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_REQUEST_TIMEOUT_SECONDS=30
MINERU_POLL_INTERVAL_SECONDS=3
MINERU_POLL_TIMEOUT_SECONDS=600
# MinerU API 失败时是否使用 pypdf 兜底
MINERU_FALLBACK_TO_PYPDF=true

# 日志目录（可选；相对路径按项目根目录解析，默认 logs）
# LOG_DIR=logs

# 日志目录（可选；相对路径按项目根目录解析，默认 logs）
# LOG_DIR=logs
